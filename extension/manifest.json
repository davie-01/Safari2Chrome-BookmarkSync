{
  "manifest_version": 3,
  "name": "BookmarkSync — 书签本机同步",
  "short_name": "BookmarkSync",
  "version": "1.0.1",
  "description": "在本机同步 Safari 与 Google Chrome™ 的书签：差异预览、逐项选择、冲突处理、双向或单向。不联网，不上传。",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": ["bookmarks", "nativeMessaging", "storage", "alarms"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "书签同步", "default_icon": { "16": "icons/16.png", "32": "icons/32.png" } },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
}
